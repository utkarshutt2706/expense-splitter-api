{
    "name": "expense-splitter-api",
    "version": "0.0.1",
    "description": "NestJS REST API for the Expense Splitter application.",
    "author": "",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "postinstall": "prisma generate",
        "build": "nest build",
        "generate:openapi": "pnpm build && node scripts/generate-openapi.mjs && prettier --write openapi.json",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\" \"prisma.config.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\" \"prisma.config.ts\" --fix",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "verify": "pnpm format:check && pnpm lint && pnpm build && node scripts/generate-openapi.mjs --check && pnpm test:cov"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/jwt": "^12.0.1",
        "@nestjs/mapped-types": "^12.0.0",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/swagger": "^12.0.1",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.10.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "tslib": "^2.8.1",
        "zod": "^4.6.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.5.1",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.12.0",
        "jest": "^30.5.1",
        "prettier": "^3.4.2",
        "prisma": "^7.10.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/*.spec.ts"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 70,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
